rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // ── Users collection ──────────────────────────────────────────────────────
    // Any authenticated user can read other users' profiles (needed for search /
    // name display in chat). Only the owner can write their own profile.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // ── Chats collection ──────────────────────────────────────────────────────
    match /chats/{chatId} {
      // Allow reading existing chats if the user is a participant,
      // or allow checking if a chat document exists (resource == null).
      allow get: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow list: if isSignedIn() && request.auth.uid in resource.data.participants;

      // Allow creating a new chat; the creator must include themselves in participants.
      allow create: if isSignedIn() &&
                       request.resource.data.participants is list &&
                       request.auth.uid in request.resource.data.participants;

      // Allow updating a chat if the user is currently a participant and remains a participant.
      allow update: if isSignedIn() &&
                       request.auth.uid in resource.data.participants &&
                       request.auth.uid in request.resource.data.participants;

      // Allow deleting a chat if participant (and for groups, creator only)
      allow delete: if isSignedIn() &&
                       request.auth.uid in resource.data.participants &&
                       (resource.data.isGroup != true || resource.data.createdBy == request.auth.uid);

      // ── Messages sub-collection ───────────────────────────────────────────
      match /messages/{messageId} {
        function parentChat() {
          return get(/databases/$(database)/documents/chats/$(chatId));
        }

        function isParentParticipant() {
          return isSignedIn() &&
                 parentChat().data != null &&
                 request.auth.uid in parentChat().data.participants;
        }

        // Only participants of the parent chat can read messages.
        allow read: if isParentParticipant();

        // Only participants can create messages, and senderId must match auth user.
        allow create: if isParentParticipant() &&
                          request.resource.data.senderId == request.auth.uid;

        // Participants can update (reactions, pinned, etc.) or delete messages.
        allow update, delete: if isParentParticipant();
      }
    }

    // ── Communities collection ────────────────────────────────────────────────
    match /communities/{communityId} {
      function isCommunityAdmin() {
        return isSignedIn() && request.auth.uid == resource.data.adminId;
      }

      function isCommunityMember() {
        return isSignedIn() && request.auth.uid in resource.data.members;
      }

      function isCommunityCreationValid() {
        return isSignedIn() &&
               request.resource.data.adminId == request.auth.uid &&
               request.auth.uid in request.resource.data.members &&
               request.resource.data.name is string &&
               request.resource.data.description is string &&
               (request.resource.data.get('photoUrl', null) == null || request.resource.data.photoUrl is string) &&
               request.resource.data.adminId is string &&
               request.resource.data.members is list &&
               request.resource.data.isPublic is bool &&
               request.resource.data.createdAt is timestamp &&
               request.resource.data.updatedAt is timestamp;
      }

      function isAdminUpdateValid() {
        return isCommunityAdmin() &&
               request.resource.data.adminId == resource.data.adminId &&
               resource.data.adminId in request.resource.data.members &&
               request.resource.data.createdAt == resource.data.createdAt &&
               request.resource.data.name is string &&
               request.resource.data.description is string &&
               (request.resource.data.get('photoUrl', null) == null || request.resource.data.photoUrl is string) &&
               request.resource.data.members is list &&
               request.resource.data.isPublic is bool &&
               request.resource.data.updatedAt is timestamp;
      }

      function isMemberUpdateValid() {
        return isCommunityMember() &&
               request.resource.data.adminId == resource.data.adminId &&
               request.resource.data.name == resource.data.name &&
               request.resource.data.description == resource.data.description &&
               request.resource.data.get('photoUrl', null) == resource.data.get('photoUrl', null) &&
               request.resource.data.isPublic == resource.data.isPublic &&
               request.resource.data.createdAt == resource.data.createdAt &&
               request.resource.data.updatedAt is timestamp &&
               request.resource.data.members is list &&
               resource.data.adminId in request.resource.data.members &&
               (
                 (request.auth.uid in request.resource.data.members && request.resource.data.members.hasAll(resource.data.members)) ||
                 (!(request.auth.uid in request.resource.data.members) && resource.data.members.hasAll(request.resource.data.members) && request.resource.data.members.size() == resource.data.members.size() - 1)
               );
      }

      function isNonMemberJoinValid() {
        return isSignedIn() &&
               !(request.auth.uid in resource.data.members) &&
               resource.data.isPublic == true &&
               request.resource.data.adminId == resource.data.adminId &&
               request.resource.data.name == resource.data.name &&
               request.resource.data.description == resource.data.description &&
               request.resource.data.get('photoUrl', null) == resource.data.get('photoUrl', null) &&
               request.resource.data.isPublic == resource.data.isPublic &&
               request.resource.data.createdAt == resource.data.createdAt &&
               request.resource.data.updatedAt is timestamp &&
               request.resource.data.members is list &&
               request.resource.data.members.hasAll(resource.data.members) &&
               request.auth.uid in request.resource.data.members &&
               request.resource.data.members.size() == resource.data.members.size() + 1;
      }

      allow read: if isSignedIn() && (resource == null || resource.data.isPublic == true || request.auth.uid in resource.data.members);
      allow create: if isCommunityCreationValid();
      allow update: if isAdminUpdateValid() || isMemberUpdateValid() || isNonMemberJoinValid();
      allow delete: if isCommunityAdmin();
    }
  }
}
